with "opencv_core";
with "opencv_imgproc";
project Ada_Consumer is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Source_Files use
     ("installed_ada.adb", "processing_check.ads", "processing_check.adb");
   for Main use ("installed_ada.adb");
   for Object_Dir use "obj-ada";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwe");
   end Compiler;
end Ada_Consumer;