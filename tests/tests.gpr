with "config/tests_config.gpr";
with "aunit";
with "opencv_imgproc";
with "../config/opencv_imgproc_install.gpr";
with "opencv_core.gpr";

project Tests is

   case OpenCV_Imgproc_Install.Shim_Build is
      when "External_Relocatable" =>
         --  MSYS2 MinGW needs its own compiler environment, not GPRbuild's
         --  mixed GNAT/MSYS2 C++ header search path.
         for Languages use ("Ada");
         for Source_Dirs use ("src/", "config/");
      when "Static_PIC" | "Relocatable" =>
         for Languages use ("Ada", "C++");
         for Source_Dirs use ("src/", "config/", "cpp/");
   end case;
   for Object_Dir use "obj/" & Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Tests_Config.Ada_Compiler_Switches & ("-Werror");
      case OpenCV_Imgproc_Install.Cxx_Toolchain is
         when "Apple_Clang" =>
            for Driver ("C++") use OpenCV_Imgproc_Install.Cxx_Driver;
            for Default_Switches ("C++") use
              ("-std=c++17", "-Wall", "-Wextra", "-Wpedantic", "-Werror",
               "-Wno-error=c11-extensions",
               OpenCV_Imgproc_Install.Include_Switch,
               "-I" & OpenCV_Core'Project_Dir & "cpp");
            for Leading_Required_Switches ("C++") use
              ("-c", "-x", "c++", "-isysroot",
               OpenCV_Imgproc_Install.Cxx_Sysroot);
            for Include_Switches ("C++") use ("-I");
            for Dependency_Switches ("C++") use ("-MMD", "-MF", "");
         when "GNU" =>
            for Driver ("C++") use OpenCV_Imgproc_Install.Cxx_Driver;
            for Default_Switches ("C++") use
              ("-std=c++17", "-Wall", "-Wextra", "-Wpedantic", "-Werror",
               OpenCV_Imgproc_Install.Include_Switch,
               "-I" & OpenCV_Core'Project_Dir & "cpp");
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      --  Tests alone compile the C++ fixture. Ensure its cv::Mat calls
      --  resolve after the test archive on every platform, including macOS.
      case OpenCV_Imgproc_Install.Shim_Build is
         when "External_Relocatable" =>
            for Switches ("Ada") use
              ("-L" & Project'Project_Dir & "obj/test_support",
               "-lopencv_imgproc_test_support");
         when "Static_PIC" | "Relocatable" =>
            for Switches ("Ada") use
              (OpenCV_Imgproc_Install.Library_Search_Switch,
               OpenCV_Imgproc_Install.OpenCV_Core_Link_Option,
               OpenCV_Imgproc_Install.Cxx_Runtime_Switch);
      end case;
   end Linker;

end Tests;
