with "opencv_core";
with "opencv_imgproc";

project Imgproc_Release_Consumer is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("release_consumer.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end Imgproc_Release_Consumer;