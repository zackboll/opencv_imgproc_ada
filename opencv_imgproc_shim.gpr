with "opencv_core.gpr";
with "config/opencv_imgproc_config.gpr";
with "config/opencv_imgproc_install.gpr";

project OpenCV_Imgproc_Shim is

   for Library_Name use "opencv_imgproc_shim";

   for Languages use ("C++");
   for Source_Dirs use ("cpp/");
   for Object_Dir use
     "obj/shim/" & OpenCV_Imgproc_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   case OpenCV_Imgproc_Install.Shim_Build is
      when "Static_PIC" =>
         for Library_Kind use "static-pic";
      when "Relocatable" =>
         for Library_Kind use "relocatable";
   end case;

   Common_Cxx_Switches :=
     ("-std=c++17",
      "-Wall",
      "-Wextra",
      "-Wpedantic",
      "-Werror",
      OpenCV_Imgproc_Install.Include_Switch,
      "-I" & OpenCV_Core'Project_Dir & "cpp");

   package Compiler is
      case OpenCV_Imgproc_Install.Cxx_Toolchain is
         when "GNU" =>
            for Default_Switches ("C++") use Common_Cxx_Switches;
            for Driver ("C++") use OpenCV_Imgproc_Install.Cxx_Driver;
         when "Apple_Clang" =>
            --  OpenCV headers use C11 _Atomic through CV_XADD. Retain
            --  -Werror while allowing that system-header extension.
            for Default_Switches ("C++") use
              Common_Cxx_Switches & ("-Wno-error=c11-extensions");
            for Driver ("C++") use OpenCV_Imgproc_Install.Cxx_Driver;
            for Leading_Required_Switches ("C++") use
              ("-c",
               "-x",
               "c++",
               "-isysroot",
               OpenCV_Imgproc_Install.Cxx_Sysroot);
            for Include_Switches ("C++") use ("-I");
            for Dependency_Switches ("C++") use ("-MMD", "-MF", "");
      end case;
   end Compiler;

   case OpenCV_Imgproc_Install.Shim_Build is
      when "Relocatable" =>
         --  The Imgproc dylib owns its OpenCV/libc++ boundary and resolves
         --  module-bridge calls directly through the Core shim dylib.
         for Library_Options use
           ("-isysroot",
            OpenCV_Imgproc_Install.Cxx_Sysroot,
            OpenCV_Imgproc_Install.Library_Search_Switch,
            OpenCV_Imgproc_Install.OpenCV_Imgproc_Link_Option,
            "-L" & OpenCV_Core'Project_Dir & "lib",
            "-lopencv_core_shim");
      when "Static_PIC" =>
         null;
   end case;

   package Linker is
      case OpenCV_Imgproc_Install.Shim_Build is
         when "Static_PIC" =>
            for Linker_Options use
              (OpenCV_Imgproc_Install.Library_Search_Switch,
               OpenCV_Imgproc_Install.OpenCV_Imgproc_Link_Option,
               OpenCV_Imgproc_Install.Cxx_Runtime_Switch);
         when "Relocatable" =>
            for Driver use OpenCV_Imgproc_Install.Cxx_Driver;
      end case;
   end Linker;

end OpenCV_Imgproc_Shim;
