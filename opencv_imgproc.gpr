with "config/opencv_imgproc_config.gpr";
with "opencv_imgproc_shim.gpr";

project Opencv_Imgproc is

   for Library_Name use "opencv_imgproc_ada";

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "src/internal/", "config/");
   for Object_Dir use "obj/" & Opencv_Imgproc_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external
       ("OPENCV_IMGPROC_LIBRARY_TYPE",
        external ("LIBRARY_TYPE", "static-pic"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Opencv_Imgproc_Config.Ada_Compiler_Switches & ("-Werror");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Opencv_Imgproc;
