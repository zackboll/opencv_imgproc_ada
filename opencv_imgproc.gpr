with "config/opencv_imgproc_config.gpr";
with "config/opencv_imgproc_install.gpr";
with "opencv_imgproc_shim.gpr";

project Opencv_Imgproc is

   for Library_Name use "opencv_imgproc_ada";

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "src/internal/", "config/");
   for Object_Dir use "obj/" & Opencv_Imgproc_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external
       ("OPENCV_IMGPROC_LIBRARY_TYPE",
        external ("LIBRARY_TYPE", "static-pic"));
   for Library_Kind use Library_Type;

   --  Preserve the Windows import library and select the configured Xcode
   --  SDK for GNAT's macOS relocatable Ada library link.
   case Library_Type is
      when "relocatable" =>
         case Opencv_Imgproc_Install.Shim_Build is
            when "External_Relocatable" =>
               for Library_Options use
                 ("-L" & Project'Project_Dir & "lib",
                  "-lopencv_imgproc_shim");
            when "Relocatable" =>
               case Opencv_Imgproc_Install.Cxx_Toolchain is
                  when "Apple_Clang" =>
                     --  GNAT otherwise uses the independent CLT SDK, which
                     --  can be newer than its supported TBD format.
                     for Library_Options use
                       ("--sysroot=" & Opencv_Imgproc_Install.Cxx_Sysroot);
                  when "GNU" =>
                     null;
               end case;
            when "Static_PIC" =>
               null;
         end case;

      when "static" | "static-pic" =>
         null;
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Opencv_Imgproc_Config.Ada_Compiler_Switches & ("-Werror");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  External_Relocatable is the Windows/MSYS2 configuration.
      --  The C++ shim is an independently built DLL, so Ada consumers
      --  must link against its import library.
      case Opencv_Imgproc_Install.Shim_Build is
         when "External_Relocatable" =>
            for Linker_Options use
              ("-L" & Project'Project_Dir & "lib",
               "-lopencv_imgproc_shim");

         when "Relocatable" =>
            case Opencv_Imgproc_Install.Cxx_Toolchain is
               when "Apple_Clang" =>
                  --  Propagate to Ada executables, including installed and
                  --  relocated consumers, without SDKROOT or LIBRARY_PATH.
                  for Linker_Options use
                    ("--sysroot=" & Opencv_Imgproc_Install.Cxx_Sysroot);
               when "GNU" =>
                  null;
            end case;
         when "Static_PIC" =>
            null;
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Opencv_Imgproc;
